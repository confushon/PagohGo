#1. Route Linked List (Core Structure)
class RouteNode:
    def __init__(self, stop_name, distance_to_next=0):
        self.stop_name = stop_name
        self.distance_to_next = distance_to_next
        self.next = None

#2. Linked List – Route List Implementation
class RouteLinkedList:
    def __init__(self, route_name):
        self.route_name = route_name
        self.head = None

    def add_stop(self, stop_name, distance_to_next=0):
        new_node = RouteNode(stop_name, distance_to_next)
        if not self.head:
            self.head = new_node
            return
        current = self.head
        while current.next:
            current = current.next
        current.next = new_node

