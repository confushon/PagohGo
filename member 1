#4. Traversal Logic – Bus Movement Simulation
def simulate_bus_travel(route):
    print(f"Bus starting route: {route.route_name}")
    current = route.head

    while current:
        print(f"Bus arrived at: {current.stop_name}")
        if current.distance_to_next > 0:
            print(f"Travelling to next stop ({current.distance_to_next} meters)")
        current = current.next

    print("Route completed.\n")

#5. Route Efficiency / Shortest Traversal Logic (Basic)
def calculate_total_distance(route):
    total_distance = 0
    current = route.head

    while current:
        total_distance += current.distance_to_next
        current = current.next

    return total_distance

#6. Bus Module (Integration)
class Bus:
    def __init__(self, bus_id, capacity):
        self.bus_id = bus_id
        self.capacity = capacity

    def start_route(self, route):
        print(f"Bus {self.bus_id} is starting the route.")
        simulate_bus_travel(route)

#7. System Integration (Main System Controller)
class BusSystem:
    def __init__(self):
        self.routes = {}
        self.buses = {}

    def add_route(self, route):
        self.routes[route.route_name] = route

    def add_bus(self, bus):
        self.buses[bus.bus_id] = bus

    def run_simulation(self, bus_id, route_name):
        bus = self.buses.get(bus_id)
        route = self.routes.get(route_name)

        if not bus or not route:
            print("Bus or Route not found.")
            return

        bus.start_route(route)
        total_distance = calculate_total_distance(route)
        print(f"Total route distance: {total_distance} meters")

#8. Main Program Execution
