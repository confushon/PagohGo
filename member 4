def display_menu():
    print("\n===== UTHM BUS MANAGEMENT SYSTEM =====")
    print("1. Add passenger to queue")
    print("2. Board passenger (remove from queue)")
    print("3. Display passenger queue")
    print("4. Exit")


def get_valid_choice():
    while True:
        try:
            choice = int(input("Enter your choice (1-4): "))
            if 1 <= choice <= 4:
                return choice
            else:
                print("❌ Invalid choice. Please enter number 1 to 4.")
        except ValueError:
            print("❌ Invalid input. Please enter a number.")


def get_valid_name():
    while True:
        name = input("Enter passenger name: ").strip()
        if name.isalpha():
            return name
        else:
            print("❌ Invalid name. Please enter alphabet characters only.")


# Placeholder functions (akan sambung dengan queue module)
def add_passenger():
    name = get_valid_name()
    print(f"✅ Passenger '{name}' added to queue.")


def remove_passenger():
    print("✅ Passenger boarded the bus.")


def display_queue():
    print("📋 Displaying passenger queue...")


def main():
    while True:
        display_menu()
        choice = get_valid_choice()

        if choice == 1:
            add_passenger()
        elif choice == 2:
            remove_passenger()
        elif choice == 3:
            display_queue()
        elif choice == 4:
            print("🚍 Exiting system. Thank you!")
            break


if __name__ == "__main__":
    main()
