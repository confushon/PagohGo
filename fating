# ===============================
# Node Class (Linked List)
# ===============================
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


# ===============================
# Passenger Queue (Linked List)
# ===============================
class PassengerQueue:
    def __init__(self):
        self.front = None
        self.rear = None
        self.size = 0

    def enqueue(self, passenger):
        new_node = Node(passenger)
        if self.rear is None:
            self.front = self.rear = new_node
        else:
            self.rear.next = new_node
            self.rear = new_node
        self.size += 1
        print(f"Passenger {passenger} added to queue.")

    def dequeue(self):
        if self.front is None:
            print("Queue is empty. No passenger to remove.")
            return
        removed = self.front.data
        self.front = self.front.next
        if self.front is None:
            self.rear = None
        self.size -= 1
        print(f"Passenger {removed} boarded the bus.")

    def display(self):
        if self.front is None:
            print("Passenger queue is empty.")
            return
        temp = self.front
        print("Passenger Queue:", end=" ")
        while temp:
            print(temp.data, end=" -> ")
            temp = temp.next
        print("None")


# ===============================
# Bus Route (Linked List)
# ===============================
class BusRoute:
    def __init__(self):
        self.head = None

    def add_stop(self, stop):
        new_node = Node(stop)
        if self.head is None:
            self.head = new_node
        else:
            temp = self.head
            while temp.next:
                temp = temp.next
            temp.next = new_node

    def display_route(self):
        if self.head is None:
            print("No bus route available.")
            return
        temp = self.head
        print("Bus Route:", end=" ")
        while temp:
            print(temp.data, end=" -> ")
            temp = temp.next
        print("END")


# ===============================
# Bus Schedule (Linked List)
# ===============================
class BusSchedule:
    def __init__(self):
        self.head = None

    def add_schedule(self, time):
        new_node = Node(time)
        if self.head is None:
            self.head = new_node
        else:
            temp = self.head
            while temp.next:
                temp = temp.next
            temp.next = new_node

    def display_schedule(self):
        if self.head is None:
            print("No bus schedule available.")
            return
        temp = self.head
        print("Bus Schedule:", end=" ")
        while temp:
            print(temp.data, end=" | ")
            temp = temp.next
        print()


# ===============================
# Main Menu (CLI)
# ===============================
def main():
    queue = PassengerQueue()
    route = BusRoute()
    schedule = BusSchedule()

    # Sample data
    route.add_stop("Hostel")
    route.add_stop("Faculty")
    route.add_stop("Library")

    schedule.add_schedule("8:00 AM")
    schedule.add_schedule("12:00 PM")
    schedule.add_schedule("5:00 PM")

    while True:
        print("\n--- Campus Bus Service System ---")
        print("1. Add Passenger")
        print("2. Remove Passenger")
        print("3. View Passenger Queue")
        print("4. View Bus Route")
        print("5. View Bus Schedule")
        print("6. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            name = input("Enter passenger name: ")
            queue.enqueue(name)
        elif choice == "2":
            queue.dequeue()
        elif choice == "3":
            queue.display()
        elif choice == "4":
            route.display_route()
        elif choice == "5":
            schedule.display_schedule()
        elif choice == "6":
            print("Exiting system...")
            break
        else:
            print("Invalid choice. Please try again.")


if __name__ == "__main__":
    main()
